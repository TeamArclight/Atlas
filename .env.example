# Atlas Planner Configuration
# To enable Gemini, copy this file to .env, set PLANNER_MODE=gemini,
# and fill the following two values from Google AI Studio. No VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=
# Mode: 'bedrock' for real AWS Bedrock inference, 'fixture' for offline deterministic test fixtures
PLANNER_MODE=fixture

# AWS Region (e.g., us-east-1, us-west-2, ap-south-1)
AWS_REGION=ap-south-2

# Optional AWS CLI named profile (leave blank to use default AWS credentials chain)
AWS_PROFILE=

# Bedrock Model ID
# Recommended models:
#   amazon.nova-lite-v1:0
#   amazon.nova-micro-v1:0
#   anthropic.claude-3-haiku-20240307-v1:0
#   anthropic.claude-3-5-sonnet-20240620-v1:0
#   meta.llama3-70b-instruct-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
